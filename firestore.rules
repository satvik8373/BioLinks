rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Bio Cards Collection
    match /bioCards/{cardId} {
      allow read, write: if true;
    }

    // Usernames Collection
    match /usernames/{handle} {
      allow read, write: if true;
    }

    // Profile drafts & published documents
    match /profiles/{userId}/{docType}/{document} {
      allow read, write: if true;
    }
    
    // User Documents & Cards Subcollection
    match /users/{userId} {
      allow read, write: if true;
      
      match /{document=**} {
        allow read, write: if true;
      }
    }
    
    // Wildcard fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

