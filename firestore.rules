rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Bio Cards Collection
    match /bioCards/{cardId} {
      allow read, write: if true;
    }
    
    // User Documents & Cards Subcollection
    match /users/{userId} {
      allow read, write: if true;
      
      match /cards/{cardId} {
        allow read, write: if true;
      }
      
      match /{document=**} {
        allow read, write: if true;
      }
    }
    
    // Test collection
    match /test/{document=**} {
      allow read, write: if true;
    }

    // Wildcard fallback for development
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

