{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BioLinksPureDeclarativeThemeConfig",
  "type": "object",
  "required": ["version", "id", "name", "extends", "category"],
  "properties": {
    "version": { "type": "string", "default": "1.0.0" },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "namespace": { "type": "string" },
    "order": { "type": "integer" },
    "extends": { "type": "string", "enum": ["base-minimal", "base-glass", "base-gradient", "base-luxury", "base-clay", "base-brutalist", "base-light", "base-dark"] },
    "category": { "type": "string", "enum": ["minimal", "glass", "clay", "luxury", "gradient", "nature", "custom"] },
    "license": { "type": ["string", "object"], "enum": ["free", "pro", "marketplace", "community"] },
    "compatibility": {
      "type": "object",
      "properties": {
        "minVersion": { "type": "string" }
      }
    },
    "preview": {
      "type": "object",
      "properties": {
        "thumbnail": { "type": "string" },
        "cover": { "type": "string" }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "author": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "background": { "type": ["string", "object"] },
    "palette": { "type": ["string", "object"] },
    "typography": { "type": ["string", "object"] },
    "spacing": { "type": ["string", "object"] },
    "layout": { "type": ["string", "object"] },
    "effects": {
      "type": "object",
      "properties": {
        "glass": { "type": "boolean" },
        "clay": { "type": "boolean" },
        "blur": { "type": "boolean" }
      }
    },
    "components": {
      "type": "object",
      "properties": {
        "profile": { "type": ["string", "object"] },
        "button": { "type": ["string", "object"] },
        "card": { "type": ["string", "object"] },
        "avatar": { "type": ["string", "object"] },
        "social": { "type": ["string", "object"] },
        "badge": { "type": ["string", "object"] },
        "footer": { "type": ["string", "object"] }
      }
    },
    "link": {
      "type": "object",
      "properties": {
        "style": { "type": "string" },
        "icon": { "type": "string" },
        "arrow": { "type": "boolean" }
      }
    },
    "visibility": {
      "type": "object",
      "properties": {
        "avatar": { "type": "boolean" },
        "bio": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "social": { "type": "boolean" },
        "footer": { "type": "boolean" },
        "musicPlayer": { "type": "boolean" },
        "shareButton": { "type": "boolean" }
      }
    },
    "supports": {
      "type": "object",
      "properties": {
        "imageBackground": { "type": "boolean" },
        "videoBackground": { "type": "boolean" },
        "animatedGradient": { "type": "boolean" },
        "particles": { "type": "boolean" },
        "customCursor": { "type": "boolean" }
      }
    },
    "a11y": {
      "type": "object",
      "properties": {
        "contrast": { "type": "string", "enum": ["AA", "AAA"] },
        "reducedMotion": { "type": "boolean" }
      }
    }
  }
}
