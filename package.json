{
  "name": "bio-link",
  "version": "1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "start": "next start",
    "lint": "eslint app components contexts lib themes --ext .ts,.tsx",
    "test": "vitest",
    "test:run": "vitest run",
    "predev": "npm run themes:sync",
    "prebuild": "npm run themes:sync",
    "prepreview": "npm run themes:sync",
    "predeploy": "npm run themes:sync",
    "preupload": "npm run themes:sync",
    "typecheck": "tsc --noEmit",
    "themes:sync": "node scripts/themes.mjs sync",
    "themes:check": "node scripts/themes.mjs check",
    "theme:create": "node scripts/themes.mjs create",
    "check": "npm run themes:check && npm run typecheck && npm run lint && npm run test:run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "ajv": "^8.20.0",
    "clsx": "2.1.1",
    "firebase": "^12.17.0",
    "firebase-admin": "^12.7.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "0.294.0",
    "next": "15.5.21",
    "next-cloudinary": "^6.17.5",
    "qrcode": "^1.5.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.7.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@types/node": "20.17.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.21",
    "fast-check": "^4.5.3",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.14",
    "ts-node": "^10.9.2",
    "typescript": "5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "4.120.1"
  }
}
